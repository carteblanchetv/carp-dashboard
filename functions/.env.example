# IMAP Configuration
IMAP_USER=mystory@carteblanche.co.za
IMAP_PASSWORD=your_password_here
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_TLS=true

# Firebase Project Configuration (for running outside Firebase Functions CLI / Emulator environment)
FIREBASE_PROJECT_ID=cb-deliverables
FIREBASE_STORAGE_BUCKET=cb-deliverables.appspot.com

# Mode: set to true to run parsing without saving to DB or marking emails as read
DRY_RUN=true

# Mailgun Inbound Webhook Signing Key
# Found in Mailgun Dashboard → Sending → Webhooks → HTTP Webhook signing key
MAILGUN_SIGNING_KEY=your-mailgun-signing-key-here

# API Key used to authenticate incoming Microsoft Power Automate webhooks
MICROSOFT_API_KEY=your_secret_api_key_here

# Microsoft Graph API Configuration
MICROSOFT_CLIENT_ID=your_client_id_here
MICROSOFT_CLIENT_SECRET=your_secret_here
MICROSOFT_TENANT_ID=your_tenant_id_here
MICROSOFT_MAILBOX_EMAIL=story@combinedartists.co.za

